DATABASE_URL="file:./dev.db"

# Requerido para las funciones de IA (detección de compromisos y borradores).
OPENAI_API_KEY="sk-..."

# Opcional — por defecto usa gpt-5.6-sol. Usa gpt-5.6-terra o gpt-5.6-luna
# para reducir costo/latencia en escaneos de Nivel 3/4.
OPENAI_MODEL="gpt-5.6-sol"

# Escaneo automático en segundo plano (src/lib/scheduler/auto-scan.ts), según
# la frecuencia del nivel de servicio activo. Dispara llamadas reales (con
# costo) a la API de IA sin necesidad de hacer clic en nada. Pon "false" para
# desactivarlo por completo.
AUTO_SCAN_ENABLED="true"

# URL donde corre esta misma app — el scheduler se autollama a /api/scan.
# Ajusta el puerto si `next dev`/`next start` no usa el 3000 por defecto.
APP_URL="http://localhost:3000"

# Secreto usado para firmar/verificar la cookie de sesión de login (JWT vía
# `jose`, ver src/lib/auth/session.ts). Requerida siempre — sin ella nadie
# puede iniciar sesión. Genera un valor largo y aleatorio por entorno, ej.:
# openssl rand -base64 32
SESSION_SECRET=""

# Secreto compartido entre el scheduler (auto-scan.ts) y /api/scan para que
# ese endpoint no quede abierto a cualquiera en internet. Opcional en local.
INTERNAL_SCAN_SECRET=""

# Clave de cifrado en reposo (AES-256-GCM) para credenciales guardadas en la
# base de datos — hoy solo MailAccount.googleRefreshToken (ver
# src/lib/crypto/encryption.ts). Requerida para conectar una cuenta de Gmail
# nueva; sin ella el callback de OAuth falla con un error legible en vez de
# guardar el refresh token sin cifrar. Debe ser base64 de exactamente 32
# bytes. Genera una por entorno con:
#   openssl rand -base64 32
# En un entorno con datos ya guardados en texto plano (ej. la demo, antes de
# este cambio), agregar esta variable NO los re-encripta solo — ver
# prisma/reencrypt-refresh-tokens.ts (ejecución manual coordinada, igual que
# el resto de la migración multi-tenant).
ENCRYPTION_KEY=""

# Conexión real a Gmail (solo lectura, scope gmail.readonly) — ver guía en
# docs/ para crear el proyecto OAuth en Google Cloud Console. Requeridas para
# usar el botón "Conectar con Google" en /settings/accounts.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
