DATABASE_URL="file:./dev.db"

# Requerido para las funciones de IA (detección de compromisos y borradores).
OPENAI_API_KEY="sk-..."

# Opcional — por defecto usa gpt-5.6-sol. Usa gpt-5.6-terra o gpt-5.6-luna
# para reducir costo/latencia en escaneos de Nivel 3/4.
OPENAI_MODEL="gpt-5.6-sol"

# Escaneo automático en segundo plano (src/lib/scheduler/auto-scan.ts), según
# la frecuencia del nivel de servicio activo. Dispara llamadas reales (con
# costo) a la API de IA sin necesidad de hacer clic en nada. Pon "false" para
# desactivarlo por completo.
AUTO_SCAN_ENABLED="true"

# URL donde corre esta misma app — el scheduler se autollama a /api/scan.
# Ajusta el puerto si `next dev`/`next start` no usa el 3000 por defecto.
APP_URL="http://localhost:3000"

# Si se define, toda la app queda detrás de una única contraseña compartida
# (pantalla /login, cookie de sesión de 14 días). Déjala vacía/sin definir
# para desactivar el gate (uso local).
DEMO_PASSWORD=""

# Secreto compartido entre el scheduler (auto-scan.ts) y /api/scan para que
# ese endpoint no quede abierto a cualquiera en internet. Opcional en local.
INTERNAL_SCAN_SECRET=""
